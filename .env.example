# Database connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_gateway2

# Provider configuration
DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Gateway Admin Secret (used for /admin/* endpoints, minimum 16 characters)
ADMIN_SECRET=change_this_to_a_secure_admin_secret_min_16_chars

# Router Models
MODEL_CHEAP=gemini-3.5-flash-lite
MODEL_CAPABLE=gemini-3.5-flash

# Resilience settings
PROVIDER_TIMEOUT_MS=20000
REQUEST_DEADLINE_MS=45000
MAX_OUTPUT_TOKENS=4096

# Router heuristic thresholds
ROUTER_LONG_PROMPT_TOKENS=1500
ROUTER_CAPABLE_MAX_TOKENS=1024

# Server Port
PORT=3000
